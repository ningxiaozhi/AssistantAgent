# ============================================================
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交
# ============================================================

# --- 数据库（Postgres 16 + pgvector）---
DATABASE_URL=postgresql://assistant:assistant@127.0.0.1:5432/assistant
DB_POOL_MIN=1
DB_POOL_MAX=5

# --- Agent 后端 ---
# auto: 装了 agentscope 就用它，否则退化为 echo（本地可跑通全链路）
# agentscope / echo: 强制指定
AGENT_BACKEND=auto

# --- 模型配置 ---
MODELS_CONFIG=config/models.yaml
# 敏感任务强制走本地模型（不信任模型自报，由路由层判定）
FORCE_LOCAL_ON_SENSITIVE=true

# --- 本地模型 ---
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- 外部模型（按需填，留空则该角色不可用）---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# --- 预算（单任务）---
MAX_STEPS=8
MAX_TOKENS=120000
MAX_USD_PER_TASK=0.15

# --- 服务 ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
