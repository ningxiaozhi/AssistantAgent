# ============================================================
# 这里只放两样东西：密钥、容器覆盖项。
# 其余配置一律在 config/*.yaml —— 那是唯一真相，且要进版本库。
#
# 复制为 .env 后使用；.env 已被 .gitignore 排除，不要提交。
# ============================================================

# --- 密钥（对应 config/models.yaml 里的 api_key_ref: env:XXX）---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# --- 可选覆盖项（只允许这几项，见 app/config.py: ENV_OVERRIDES）---
# ASSISTANT_CONFIG_DIR=./config
# DATABASE_URL=postgresql://user:pass@host:5432/db
# AGENT_BACKEND=auto          # auto | agentscope | echo
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
